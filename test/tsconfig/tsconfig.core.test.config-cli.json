{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-config-cli.tsbuildinfo"
  },
  "include": [
    "../../src/config/**/*.test.ts",
    "../../src/config/**/*.test.tsx",
    "../../src/cli/**/*.test.ts",
    "../../src/cli/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/cli/daemon-cli/**",
    "../../src/cli/update-cli/update-command-executor*.test.ts",
    "../../src/cli/update-cli/update-command-executor*.test.tsx",
    "../../src/cli/update-cli/update-command-service*.test.ts",
    "../../src/cli/update-cli/update-command-service*.test.tsx",
    "../../src/config/sessions/**"
  ]
}
